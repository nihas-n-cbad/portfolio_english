# Contact API
PORT=4001
# Origin allowed to call the API (the Vite dev server by default)
ALLOWED_ORIGIN=http://localhost:5173

# Where enquiries are emailed. Without SMTP settings they are still stored
# in backend/data/messages.jsonl.
CONTACT_TO=hola@yourname.com

# Optional SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Serve the built frontend from this server (npm run build in /frontend first)
SERVE_STATIC=false
